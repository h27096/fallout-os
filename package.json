{
  "name": "fallout-os",
  "version": "0.8.1",
  "private": true,
  "description": "Fallout OS desktop and web workspace",
  "author": "Fallout OS contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "web": "node tools/serve.cjs",
    "test": "node --test --test-concurrency=1 *.test.cjs",
    "test:desktop": "node tools/desktop-smoke.cjs",
    "test:browser": "node tools/vaultnet-smoke.cjs",
    "pack:win": "node tools/build-windows.cjs --dir",
    "build:win": "node tools/build-windows.cjs",
    "verify:win": "node tools/verify-runtime.cjs"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "com.robco.falloutos",
    "productName": "Fallout OS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.html",
      "*.css",
      "*.js",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}",
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "./tools/verify-runtime.cjs",
    "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
  }
}
